# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TAVILY_API_KEY: Tavily Web Search API key used by Glass Box AI backend.
TAVILY_API_KEY=""

# ASI_CLOUD_KEY: SingularityNET ASI Cloud API key for requirement extraction.
ASI_CLOUD_KEY=""

# PYTHON_BACKEND_URL: Optional URL to external Python FastAPI/Flask backend (e.g., http://localhost:8000)
PYTHON_BACKEND_URL="http://127.0.0.1:8000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
